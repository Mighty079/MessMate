<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TODAY'S MENU"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <!-- Breakfast Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Breakfast:"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/widget_breakfast_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Puri, Aloo Sabzi, Tea"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lunch Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Lunch:"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/widget_lunch_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Special Biryani, Raita"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Snacks Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Snacks:"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/widget_snacks_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maggi, Tea"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Dinner Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Dinner:"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/widget_dinner_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapati, Paneer Matar"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
